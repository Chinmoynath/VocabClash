{
  "headers": [
    {
      "source": "/(firebase-messaging-sw\\.js|sw\\.js|service-worker\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|firebase-messaging-sw\\.js|sw\\.js|service-worker\\.js|manifest\\.json|robots\\.txt|sitemap\\.xml|ads\\.txt|app-ads\\.txt|\\.well-known/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
