{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile, player career stats, streak, and subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Google avatar URL" },
        "player": { "type": "object", "description": "Player in-game rank, level, and stats" },
        "subscription": { "type": "object", "description": "User subscription plan details" },
        "streak": { "type": "object", "description": "Daily attendance and study streak record" },
        "savedWords": { "type": "array", "description": "Vocabulary mistakes and revision vault" },
        "updatedAt": { "type": "number", "description": "Epoch timestamp of last update" }
      },
      "required": ["uid", "updatedAt"]
    },
    "MatchQueueTicket": {
      "title": "MatchQueueTicket",
      "description": "Real-time 1v1 matchmaking queue ticket with active state transitions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Ticket ID (ticket_{userId})" },
        "userId": { "type": "string", "description": "Player user ID" },
        "playerName": { "type": "string", "description": "Player name" },
        "avatar": { "type": "string", "description": "Player avatar emoji" },
        "rankPoints": { "type": "number", "description": "Player LP rating" },
        "targetExam": { "type": "string", "description": "Target exam" },
        "category": { "type": "string", "description": "Selected question category" },
        "exam": { "type": "string", "description": "Selected exam filter" },
        "roundCount": { "type": "number", "description": "Number of questions" },
        "status": { "type": "string", "description": "searching, matched, cancelled, or expired" },
        "matchedRoomId": { "type": "string", "description": "ID of created match room" },
        "matchedOpponent": { "type": "object", "description": "Opponent player profile" },
        "questions": { "type": "array", "description": "Shared synchronized question set" },
        "createdAt": { "type": "number", "description": "Creation timestamp in ms" },
        "expiresAt": { "type": "number", "description": "Expiration timestamp in ms" }
      },
      "required": ["id", "userId", "status", "createdAt"]
    },
    "LiveDuelRoom": {
      "title": "LiveDuelRoom",
      "description": "Real-time synchronized 1v1 match document shared by both players",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Room ID" },
        "roomId": { "type": "string", "description": "Unique match ID" },
        "mode": { "type": "string", "description": "1v1_ranked, quick_duel, or friend_lobby" },
        "category": { "type": "string", "description": "Category" },
        "exam": { "type": "string", "description": "Exam" },
        "roundCount": { "type": "number", "description": "Rounds" },
        "player1": { "type": "object", "description": "Host player profile" },
        "player2": { "type": "object", "description": "Challenger player profile" },
        "questions": { "type": "array", "description": "Shared synchronized question array" },
        "status": { "type": "string", "description": "waiting, in_progress, or completed" },
        "currentQIndex": { "type": "number", "description": "Current active question index" },
        "p1Score": { "type": "number", "description": "Player 1 score" },
        "p2Score": { "type": "number", "description": "Player 2 score" },
        "p1Combo": { "type": "number", "description": "Player 1 combo streak" },
        "p2Combo": { "type": "number", "description": "Player 2 combo streak" },
        "createdAt": { "type": "number", "description": "Timestamp created" },
        "updatedAt": { "type": "number", "description": "Timestamp updated" }
      },
      "required": ["id", "roomId", "player1", "player2", "status", "createdAt"]
    },
    "FriendLobby": {
      "title": "FriendLobby",
      "description": "Custom private 6-digit lobby for playing 1v1 matches with friends",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "6-digit numeric room code" },
        "roomId": { "type": "string", "description": "Unique match room ID" },
        "host": { "type": "object", "description": "Host player profile" },
        "guest": { "type": "object", "description": "Guest player profile" },
        "category": { "type": "string", "description": "Question category filter" },
        "exam": { "type": "string", "description": "Target exam filter" },
        "roundCount": { "type": "number", "description": "Number of questions in match" },
        "status": { "type": "string", "description": "waiting, ready, starting, in_progress, cancelled, or expired" },
        "questions": { "type": "array", "description": "Synchronized questions list" },
        "hostReady": { "type": "boolean", "description": "Host readiness state" },
        "guestReady": { "type": "boolean", "description": "Guest readiness state" },
        "createdAt": { "type": "number", "description": "Creation timestamp in ms" },
        "expiresAt": { "type": "number", "description": "Expiration timestamp in ms" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp in ms" }
      },
      "required": ["code", "roomId", "host", "status", "createdAt"]
    },
    "QuestionBankItem": {
      "title": "QuestionBankItem",
      "description": "Approved and published government exam PYQ item in live VocabClash Question Bank",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique question ID" },
        "category": { "type": "string", "description": "synonyms, antonyms, ows, or idioms" },
        "wordOrPhrase": { "type": "string", "description": "Core target word or phrase" },
        "instruction": { "type": "string", "description": "Question instruction" },
        "options": { "type": "array", "description": "Array of 4 options" },
        "correctIndex": { "type": "number", "description": "0-indexed correct option" },
        "meaning": { "type": "string", "description": "English meaning" },
        "hindiMeaning": { "type": "string", "description": "Hindi translation/meaning" },
        "exampleSentence": { "type": "string", "description": "Contextual usage sentence" },
        "mnemonic": { "type": "string", "description": "Memory trick / Hinglish hook" },
        "rootWordInfo": { "type": "string", "description": "Etymology or origin" },
        "examHistory": { "type": "array", "description": "Array of exam appearances" },
        "repeatCount": { "type": "number", "description": "Historical repeat count" },
        "importanceLevel": { "type": "string", "description": "ultra-high, very-high, or high" },
        "difficulty": { "type": "string", "description": "easy, medium, or hard" },
        "isPYQ": { "type": "boolean", "description": "True for authentic PYQ" },
        "verified": { "type": "boolean", "description": "True if admin-approved" },
        "sourceBatchId": { "type": "string", "description": "ID of import batch" },
        "createdAt": { "type": "number", "description": "Timestamp created in ms" },
        "updatedAt": { "type": "number", "description": "Timestamp updated in ms" }
      },
      "required": ["id", "category", "wordOrPhrase", "options", "correctIndex"]
    },
    "PyqImportBatch": {
      "title": "PyqImportBatch",
      "description": "Metadata for an imported JSON / PDF batch of PYQ questions",
      "type": "object",
      "properties": {
        "batchId": { "type": "string", "description": "Unique batch ID" },
        "sourceFileName": { "type": "string", "description": "Original source file name" },
        "examFamily": { "type": "string", "description": "Exam family (SSC, Banking, etc.)" },
        "exam": { "type": "string", "description": "Exam name" },
        "year": { "type": "number", "description": "Exam year" },
        "tier": { "type": "string", "description": "Tier or stage" },
        "shift": { "type": "string", "description": "Exam shift" },
        "paper": { "type": "string", "description": "Exam paper/subject" },
        "dateImported": { "type": "number", "description": "Import timestamp" },
        "totalDetected": { "type": "number", "description": "Total eligible questions detected" },
        "approvedCount": { "type": "number", "description": "Count of approved questions" },
        "publishedCount": { "type": "number", "description": "Count of published questions" },
        "status": { "type": "string", "description": "pending_review, completed, or discarded" },
        "updatedAt": { "type": "number", "description": "Timestamp last updated" }
      },
      "required": ["batchId", "dateImported", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and synchronization state"
    },
    "/match_queue/{ticketId}": {
      "schema": "MatchQueueTicket",
      "description": "Real-time 1v1 matchmaking queue tickets with onSnapshot subscriptions and atomic transaction matching"
    },
    "/live_rooms/{roomId}": {
      "schema": "LiveDuelRoom",
      "description": "Shared synchronized 1v1 live duel rooms"
    },
    "/friend_lobbies/{lobbyCode}": {
      "schema": "FriendLobby",
      "description": "Private 6-digit custom rooms for 1v1 battles with friends"
    },
    "/friendRooms/{lobbyCode}": {
      "schema": "FriendLobby",
      "description": "Private 6-digit custom rooms for 1v1 battles with friends (canonical alias)"
    },
    "/question_bank/{questionId}": {
      "schema": "QuestionBankItem",
      "description": "Published and verified authentic PYQ question bank items for VocabClash"
    },
    "/pyq_import_batches/{batchId}": {
      "schema": "PyqImportBatch",
      "description": "Admin batch ingestion logs and tracking"
    }
  }
}
