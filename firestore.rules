rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isPyqAdmin() {
      return request.auth != null && request.auth.token.email == 'nathchinmoy777@gmail.com';
    }

    // User Profile Document (Authenticated Owner access)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Real-time Matchmaking Queue
    // Allow players to read active queue tickets, create ticket, update during atomic match transaction, and clean up
    match /match_queue/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.userId is string 
                    && request.resource.data.status is string
                    && request.resource.data.createdAt is number;
      allow update: if request.resource.data.status in ['searching', 'matched', 'cancelled', 'expired'];
      allow delete: if true;
    }

    // Shared Synchronized 1v1 Live Rooms
    match /live_rooms/{roomId} {
      allow read, write: if true;
    }

    // Custom 6-Digit Friend Lobbies
    match /friend_lobbies/{lobbyCode} {
      allow read, write: if true;
    }

    match /friendRooms/{lobbyCode} {
      allow read, write: if true;
    }

    // Question Bank: Public read for client arena/drills, Admin-only write
    match /question_bank/{questionId} {
      allow read: if true;
      allow create, update, delete: if isPyqAdmin();
    }

    // PYQ Import Batches: Admin-only read/write
    match /pyq_import_batches/{batchId} {
      allow read, write: if isPyqAdmin();
    }
  }
}
