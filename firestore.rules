rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isPyqAdmin() {
      return request.auth != null && request.auth.token.email == 'nathchinmoy777@gmail.com';
    }

    // User Profile Document and subcollections (Authenticated Owner access)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared AI Vocab Mentor Word Explanation Cache
    match /ai_tutor_cache/{wordId} {
      allow read, write: if true;
    }

    // Real-time Matchmaking Queue
    // Allow players to read active queue documents, create queue tickets, update during atomic match transaction, and clean up
    match /matchmaking_queue/{uid} {
      allow read, write: if true;
    }

    match /match_queue/{ticketId} {
      allow read, write: if true;
    }

    // Shared Synchronized 1v1 Live Rooms
    match /live_rooms/{roomId} {
      allow read, write: if true;
    }

    // Custom 6-Digit Friend Lobbies
    match /friend_lobbies/{lobbyCode} {
      allow read, write: if true;
    }

    match /friendRooms/{lobbyCode} {
      allow read, write: if true;
    }

    // Realtime Global Leaderboard Users
    match /leaderboard_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Match Records
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Question Bank: Public read for client arena/drills, Admin-only write
    match /question_bank/{questionId} {
      allow read: if true;
      allow create, update, delete: if isPyqAdmin();
    }

    // PYQ Import Batches: Admin-only read/write
    match /pyq_import_batches/{batchId} {
      allow read, write: if isPyqAdmin();
    }

    // PYQ Import Conflicts: Admin-only read/write
    match /pyq_import_conflicts/{conflictId} {
      allow read, write: if isPyqAdmin();
    }

    // SSC Top 100 Pools: Public read for aspirants, Admin-only write
    match /ssc_top100/{category} {
      allow read: if true;
      allow write: if isPyqAdmin();
    }

    // SSC Vocab Frequency Aggregates: Public read, Admin-only write
    match /ssc_vocab_frequency/{conceptKey} {
      allow read: if true;
      allow write: if isPyqAdmin();
    }
  }
}
