# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY CONFIGURATION (Test or Live Key from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# GOOGLE ADSENSE & ADMOB INTEGRATION (Web & App)
# Master Feature Flag: Set to 'true' to activate ad banners, intermission modals, and timers.
# Keep 'false' while ad accounts are under review or when running clean ad-free study mode.
VITE_ADS_ENABLED=false
VITE_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-6402582146558440"
VITE_GOOGLE_ADSENSE_SLOT_INTERSTITIAL="5100703845"
VITE_GOOGLE_ADSENSE_SLOT_BANNER="5596523711"
VITE_GOOGLE_ADMOB_APP_ID="ca-app-pub-6402582146558440~1650072679"
VITE_GOOGLE_ADMOB_UNIT_ID="ca-app-pub-6402582146558440/5596523711"
VITE_GOOGLE_ADMOB_UNIT_INTERSTITIAL="ca-app-pub-6402582146558440/5596523711"

# GOOGLE PLAY BILLING (Keyless Vercel OIDC + Google Cloud Workload Identity Federation)
# All values below are non-secret configuration variables
GOOGLE_CLOUD_PROJECT_NUMBER="970204579955"
GOOGLE_WIF_POOL_ID="vercel"
GOOGLE_WIF_PROVIDER_ID="vercel"
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL="vocabclash-play-billing@tactile-world-jq6d2.iam.gserviceaccount.com"
GOOGLE_PLAY_PACKAGE_NAME="in.vocabclash.twa"

# Used to send authentic 6-digit OTP verification emails to user inboxes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VocabClash Arena <noreply@vocabclash.app>"
GMAIL_USER=
GMAIL_APP_PASSWORD=


